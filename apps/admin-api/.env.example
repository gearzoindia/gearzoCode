# Application
NODE_ENV=development
PORT=4003
APP_AUDIENCE=admin
API_PREFIX=v1

# URLs & CORS
FRONTEND_URL=https://admin.gearzo.in
STAGING_FRONTEND_URL=https://staging-admin.gearzo.in
ALLOWED_ORIGINS=https://admin.gearzo.in,https://staging-admin.gearzo.in,http://localhost:3000,http://localhost:3002

# Database & Redis
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gearzo?schema=public
REDIS_URL=redis://localhost:6379

# Auth & JWT
JWT_ACCESS_SECRET=super-secret-admin-jwt-key-minimum-32-chars-long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# 2FA / TOTP AES-256 Key (64 hex characters or 32-byte string)
TOTP_ENC_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# OTP Provider
OTP_PROVIDER=mock
ALLOW_MOCK_OTP_IN_PROD=false
SMS_GATEWAY_API_KEY=

# Storage
STORAGE_PROVIDER=s3
STORAGE_BUCKET=gearzo-admin-assets
STORAGE_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
