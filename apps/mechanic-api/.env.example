# Application
NODE_ENV=development
PORT=4002
APP_AUDIENCE=mechanic
API_PREFIX=v1

# URLs & CORS
FRONTEND_URL=https://mechanic.gearzo.in
STAGING_FRONTEND_URL=https://staging-mechanic.gearzo.in
ALLOWED_ORIGINS=https://mechanic.gearzo.in,https://staging-mechanic.gearzo.in,http://localhost:3000,http://localhost:8081

# Database & Redis
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gearzo?schema=public
REDIS_URL=redis://localhost:6379

# Auth & JWT
JWT_SECRET=super-secret-jwt-key-minimum-32-chars-long-mechanic
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# OTP Provider
OTP_PROVIDER=mock
ALLOW_MOCK_OTP_IN_PROD=false
SMS_GATEWAY_API_KEY=

# Payments
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_samplekeyid123
RAZORPAY_KEY_SECRET=rzp_test_samplekeysecret456
RAZORPAY_WEBHOOK_SECRET=sample_razorpay_webhook_secret

# Storage
STORAGE_PROVIDER=s3
STORAGE_BUCKET=gearzo-mechanic-assets
STORAGE_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
