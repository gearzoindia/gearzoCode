model PushToken {
  id        String   @id @default(uuid()) @db.Uuid
  subjectId String   @db.Uuid
  audience  Audience
  token     String
  platform  Platform
  createdAt DateTime @default(now())

  @@unique([subjectId, token])
  @@index([subjectId, audience])
  @@index([token])
  @@map("push_tokens")
}
